<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file publish for deployment to the UNC share (replaces ClickOnce).
  Run from the repo root:

      dotnet publish FreightEstApp35 -p:PublishProfile=SelfContainedSingleFile

  Output: FreightEstApp35\bin\publish\ containing FreightEstApp35.exe and FreightEstApp35.dll.config.

  - No .NET runtime needs to be installed on the host.
  - Configuration lives in FreightEstApp35.dll.config (a copy of App.config). A single-file exe
    does NOT read FreightEstApp35.exe.config; a renamed copy is silently ignored.
  - IncludeNativeLibrariesForSelfExtract bundles Microsoft.Data.SqlClient.SNI.dll into the exe;
    without it SQL access fails with a TypeInitializationException.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>bin\publish\</PublishDir>
  </PropertyGroup>
</Project>
