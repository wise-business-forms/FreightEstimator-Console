<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- Carrier credentials are not in this file: they come from secrets.config beside the exe (git-ignored;
       template: secrets.config.example) or from the same keys in a deployed config. See ADR 0005. -->
  <appSettings file="secrets.config">
    <add key="RemoteServerName" value="SANDBOX" />
    <add key="LogFileName" value="CarrierTestHarness.log" />

    <!-- Machine names (comma or semicolon separated) that run as Production Hosts. Any machine not listed
         runs in Test Mode: it uses Windows Integrated Security and refuses to start unless both PROD_Server
         and RemoteServerName are SANDBOX. Leave empty on workstations. -->
    <add key="ProductionHosts" value="" />

    <add key="PROD_Server" value="SANDBOX" />
    <!-- Production Hosts only (SQL authentication): set PROD_User and PROD_Password in secrets.config or the deployed config, never in this file.
    <add key="PROD_User" value="" />
    <add key="PROD_Password" value="" />
    -->
  </appSettings>
</configuration>
